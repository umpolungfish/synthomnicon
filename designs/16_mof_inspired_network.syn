# Design 16: MOF-Inspired Network Assembly — Extended Topology Design
# =====================================================================
# Demonstrates: Network topology formation, extended structure
# assembly, T_cage operations, hierarchical organization

version: "1.0"
start: nitroso_radical_anion_π_cryptand_cage_synthon

strategies:
  # Form larger assembly from cage building blocks
  assemble_network:
    # Tensor two cages (should stay cage or promote)
    - tensor: nitroso_radical_cucurbituril_anion_rotaxane_synthon
      lambda: 0.4

do:
  # Execute network assembly
  - bind: assemble_network
  
  # Assert topology is cage (tensor of two cages)
  - assert:
      expr: topology == T_cage
      message: "Cage assembly should produce T_cage"
  
  # Assert high fidelity (all partners are F_hbar)
  - assert:
      expr: fidelity == F_hbar
      message: "All partners are F_hbar, ensemble should be F_hbar"
  
  # Note: We don't attempt lift(critical) here because this is
  # a supramolecular (D_triangle) synthon, not temporal (D_infinity).
  # Criticality lift requires D_∞ OR G >= G_gimel (mesoscale).
  # This demonstrates the D-floor gate for criticality.

output:
  format: text
  save: results/16_mof_inspired_network.json
  assert:
    - total_delta_xi < 20.0
    - steps <= 6
