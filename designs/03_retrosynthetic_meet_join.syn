# Design 03: Retrosynthetic Analysis — Meet/Join Lattice Operations
# ==================================================================
# This script performs retrosynthetic analysis by computing the meet
# of two target synthons to find their common precursor motif.
# Demonstrates: meet, join, lattice conflicts, F-floor propagation

version: "1.0"
start: carboxylic_acid_dimer

do:
  # Step 1: Compute meet with amide dimer (both are T_bowtie H-bonded dimers)
  # This should succeed and find the common H-bonded dimer motif
  - meet: amide_dimer
  
  # Step 2: Assert the meet preserved the cyclic topology
  - assert:
      expr: topology == T_bowtie
      message: "Meet of two T_bowtie synthons must be T_bowtie"
  
  # Step 3: Assert the meet lowered fidelity (F_hbar ⊓ F_eth → F_eth)
  - assert:
      expr: fidelity == F_eth
      message: "Meet should lower F to minimum (F_eth)"
  
  # Step 4: Join with another F_hbar synthon that has compatible P and Γ
  # Using carboxylic_acid_dimer join with itself (idempotent test)
  - join: carboxylic_acid_dimer
  
  # Step 5: Assert idempotency (join with self = self)
  - assert:
      expr: fidelity == F_hbar
      message: "Join with self should preserve F_hbar"

output:
  format: text
  save: results/03_retrosynthetic_meet_join.json
