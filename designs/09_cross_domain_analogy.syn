# Design 09: Cross-Domain Analogy Search — Supramolecular Cluster
# =================================================================
# Demonstrates: Path search within D/T cluster, structural similarity,
# HotSwap constraints (D/T must match)

version: "1.0"
start: nitroso_radical_crown_ether_host_guest_synthon

do:
  # Step 1: Search within same D/T class (D_triangle, T_bowtie)
  # This demonstrates valid analogy search (same structural constraints)
  - path: nitroso_radical_crown_ether_anion_π_rotaxane_synthon
    xi_tolerance: 3.0
    max_hops: 8
  
  # Step 2: If path succeeded, tensor with another cage system
  - tensor: nitroso_radical_cucurbituril_anion_rotaxane_synthon
    lambda: 0.4
  
  # Step 3: Assert topology promoted
  - assert:
      expr: topology == T_cage
      message: "Tensor should promote to cage topology"

output:
  format: json
  save: results/09_cross_domain_analogy.json
