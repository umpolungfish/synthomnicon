# Design 15: DNA Base Pair Lattice — Biological Supramolecular Design
# ====================================================================
# Demonstrates: Biological synthon manipulation, H-bond network
# analysis, lattice operations on biological systems

version: "1.0"
start: adenine_thymine_pair

do:
  # Step 1: Join with self (idempotency test)
  - join: adenine_thymine_pair
  
  # Step 2: Assert A·T properties preserved
  - assert:
      expr: topology == T_bowtie
      message: "A·T topology must be preserved"
  
  # Step 3: Assert fidelity preserved
  - assert:
      expr: fidelity == F_hbar
      message: "F_hbar must be preserved"
  
  # Step 4: Path to another high-fidelity bowtie system
  - path: carboxylic_acid_dimer
    xi_tolerance: 3.0
    max_hops: 6
  
  # Step 5: Validate we reached the target
  - assert:
      expr: fidelity == F_hbar
      message: "Target fidelity must be F_hbar"

output:
  format: json
  save: results/15_dna_base_pair_lattice.json
  assert:
    - total_delta_xi < 10.0
    - steps <= 10
