# Design 04: Hybrid Spatial-Temporal System — Cross-Domain Design
# ================================================================
# This script attempts to design a hybrid system combining
# temporal (D_∞) and supramolecular (D_△) domains.
# Demonstrates: cross-domain tensor, hybrid D propagation,
# Axiom 6 temporal grounding checks, or-fallback pattern

version: "1.0"
start: proline_aldol_cycle

strategies:
  # Strategy: attempt hybrid formation with fallback
  hybrid_or_fallback:
    - or:
        # Primary: tensor with supramolecular cage
        - tensor: nitroso_radical_anion_π_cavitand_cage_synthon
          lambda: 0.4
        # Fallback: tensor with simpler bowl topology
        - tensor: nitroso_radical_calixarene_anion_π_sandwich_synthon
          lambda: 0.3

do:
  # Step 1: Attempt hybrid formation (temporal ⊗ supramolecular)
  - bind: hybrid_or_fallback
  
  # Step 2: Assert Axiom 6 temporal grounding is satisfied
  # (proline_aldol_cycle is D_∞ and requires grounding)
  - assert:
      expr: axiom6_satisfied
      message: "Hybrid must satisfy Axiom 6 temporal grounding"
  
  # Step 3: Assert fidelity bottleneck (proline is F_eth)
  - assert:
      expr: fidelity == F_eth
      message: "Fidelity bottlenecked by proline (F_eth)"
  
  # Step 4: Lift to criticality if not already critical
  - lift: critical
  
  # Step 5: Assert we achieved criticality phase
  - assert:
      expr: criticality_phase == Phi_c
      message: "Must reach Phi_c after criticality lift"

output:
  format: text
  save: results/04_hybrid_spatial_temporal.json
