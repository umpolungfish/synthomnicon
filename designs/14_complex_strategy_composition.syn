# Design 14: Complex Strategy Composition — Nested Or-Patterns
# =============================================================
# Demonstrates: Deep strategy nesting, multi-level fallback,
# robust error handling, alternative pathway exploration

version: "1.0"
start: proline_aldol_cycle

strategies:
  # Primary: direct criticality (will fail due to F-floor)
  direct_criticality:
    - lift: critical
  
  # Fallback 1: upgrade F then lift
  upgrade_then_lift:
    - join: nitroso_radical_redox_synthon_pair
    - lift: critical
  
  # Fallback 2: path to high-F system then lift
  path_then_lift:
    - path: nitroso_radical_redox_synthon_pair
      xi_tolerance: 3.0
      max_hops: 8
    - lift: critical
  
  # Composite: try primary, then fallback 1, then fallback 2
  robust_criticality:
    - or:
        - bind: direct_criticality
        - bind: upgrade_then_lift
        - bind: path_then_lift

do:
  # Execute the robust criticality strategy
  - bind: robust_criticality
  
  # Validate we achieved criticality through some path
  - assert:
      expr: criticality_phase == Phi_c
      message: "Must achieve criticality through some pathway"
  
  # Validate Varma probe score
  - assert:
      expr: phi_c_score > 0.3
      message: "Critical system must have meaningful phi_c"

output:
  format: text
  save: results/14_complex_strategy_composition.json
  assert:
    - steps <= 15
