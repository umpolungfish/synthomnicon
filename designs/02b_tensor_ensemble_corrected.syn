# Design 02b: Tensor Ensemble — Corrected Version
# =================================================
# This version demonstrates tensor product with fidelity bottleneck.
# Both partners are F_eth, so the ensemble is F_eth (bottleneck).
# Criticality requires F_hbar, so we don't attempt the lift here.

version: "1.0"
start: nitroso_radical_crown_ether_host_guest_synthon

strategies:
  # Named sub-strategy: ensemble formation
  form_ensemble:
    - tensor: nitroso_radical_cucurbituril_anion_rotaxane_synthon
      lambda: 0.5  # High mutual information (both are cage-like)

do:
  # Step 1: Form the ensemble via tensor product
  - bind: form_ensemble
  
  # Step 2: Assert the ensemble has the predicted fidelity bottleneck
  # (should be F_eth since both partners are F_eth)
  - assert:
      expr: fidelity == F_eth
      message: "Ensemble fidelity must match bottleneck (F_eth)"
  
  # Step 3: Assert the topology promoted correctly (cage > bowl)
  - assert:
      expr: topology == T_cage
      message: "Ensemble topology should promote to T_cage"
  
  # Step 4: Join with a high-fidelity partner to raise F-floor
  - join: nitroso_radical_anion_π_cryptand_cage_synthon
  
  # Step 5: Assert F was raised to F_hbar
  - assert:
      expr: fidelity == F_hbar
      message: "Join should raise F to F_hbar"
  
  # Step 6: Now lift to criticality (F_hbar meets requirement)
  - lift: critical
  
  # Step 7: Verify criticality achieved
  - assert:
      expr: criticality_phase == Phi_c
      message: "Criticality lift must succeed"

output:
  format: json
  save: results/02b_tensor_ensemble_corrected.json
