# Design 05b: Varma Probe Validation — Corrected Version
# =======================================================
# This version focuses on the Varma probe validation itself
# and uses meet with a compatible partner.

version: "1.0"
start: nitroso_radical_redox_synthon_pair

do:
  # Step 1: Lift to criticality (this synthon is a good candidate)
  - lift: critical
  
  # Step 2: Assert phi_c_score exceeds threshold
  # (Varma probe runs and computes criticality score)
  - assert:
      expr: phi_c_score > 0.3
      message: "Criticality candidate must have phi_c > 0.3"
  
  # Step 3: Check that we reached criticality phase
  - assert:
      expr: criticality_phase == Phi_c
      message: "Must be in Phi_c phase after lift"
  
  # Step 4: Join with another high-fidelity temporal synthon
  - join: nitroso_radical_redox_synthon_pair
  
  # Step 5: Assert idempotency (join with self = self)
  - assert:
      expr: criticality_phase == Phi_c
      message: "Join with self should preserve Phi_c"

output:
  format: json
  save: results/05b_varma_probe_corrected.json
  assert:
    # Post-hoc cost gates (evalRWS-style)
    - total_delta_xi < 5.0    # Budget check (should be 0 for lift+join)
    - total_delta_xi >= 0.0   # Non-negative check
    - steps <= 8              # Step budget
