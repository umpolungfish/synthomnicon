# Design 02: Supramolecular Ensemble — Tensor Product Design
# ===========================================================
# This script designs a co-assembly by tensoring two synthons:
# a crown ether host-guest system with a cucurbituril cage.
# Demonstrates: tensor with lambda parameter, fidelity bottleneck

version: "1.0"
start: nitroso_radical_crown_ether_host_guest_synthon

strategies:
  # Named sub-strategy: ensemble formation
  form_ensemble:
    - tensor: nitroso_radical_cucurbituril_anion_rotaxane_synthon
      lambda: 0.5  # High mutual information (both are cage-like)

do:
  # Step 1: Form the ensemble via tensor product
  - bind: form_ensemble
  
  # Step 2: Assert the ensemble has the predicted fidelity bottleneck
  # (should be F_eth since both partners are F_eth)
  - assert:
      expr: fidelity == F_eth
      message: "Ensemble fidelity must match bottleneck (F_eth)"
  
  # Step 3: Assert the topology promoted correctly (cage > bowl)
  - assert:
      expr: topology == T_cage
      message: "Ensemble topology should promote to T_cage"
  
  # Step 4: Check that criticality propagated (if either was critical)
  - assert:
      expr: criticality_phase == Phi_c
      message: "Criticality should propagate through tensor"

output:
  format: json
  save: results/02_tensor_ensemble_design.json
