# Design 04b: Hybrid Spatial-Temporal — Corrected Version
# ========================================================
# This version uses a known catalog entry and starts from
# a high-fidelity temporal synthon to pass the F-floor gate.

version: "1.0"
start: nitroso_radical_redox_synthon_pair

strategies:
  # Strategy: hybrid formation with fallback (both targets exist)
  hybrid_or_fallback:
    - or:
        # Primary: tensor with supramolecular cage
        - tensor: nitroso_radical_anion_π_cryptand_cage_synthon
          lambda: 0.4
        # Fallback: tensor with bowl topology
        - tensor: nitroso_radical_calixarene_anion_π_sandwich_synthon
          lambda: 0.3

do:
  # Step 1: Attempt hybrid formation (temporal ⊗ supramolecular)
  - bind: hybrid_or_fallback
  
  # Step 2: Assert Axiom 6 temporal grounding is satisfied
  - assert:
      expr: axiom6_satisfied
      message: "Hybrid must satisfy Axiom 6 temporal grounding"
  
  # Step 3: Assert fidelity bottleneck (redox pair is F_hbar)
  - assert:
      expr: fidelity == F_hbar
      message: "Fidelity should be F_hbar (both partners high fidelity)"
  
  # Step 4: Lift to criticality (F_hbar meets requirement)
  - lift: critical
  
  # Step 5: Assert we achieved criticality phase
  - assert:
      expr: criticality_phase == Phi_c
      message: "Must reach Phi_c after criticality lift"
  
  # Step 6: Assert phi_c_score passes threshold
  - assert:
      expr: phi_c_score > 0.3
      message: "Criticality candidate must have phi_c > 0.3"

output:
  format: text
  save: results/04b_hybrid_spatial_temporal_corrected.json
