# Design 08: Retrodesign Search Pattern — Same D/T Class
# ========================================================
# Demonstrates: Path-based retrodesign within D/T cluster,
# search space exploration, hop-limited discovery

version: "1.0"
start: enolate_synthon

do:
  # Step 1: Search for path within same D/T class (D_wedge, T_linear)
  - path: carbonyl_synthon
    xi_tolerance: 3.0
    max_hops: 6
  
  # Step 2: Join with self (idempotency - same synthon)
  - join: carbonyl_synthon
  
  # Step 3: Assert fidelity preserved
  - assert:
      expr: fidelity == F_eth
      message: "F_eth must be preserved"
  
  # Step 4: Path to another linear synthon
  - path: synthon_methyl_anion_nucleophile_CH3_
    xi_tolerance: 3.0
    max_hops: 6
  
  # Step 5: Validate we reached the target class
  - assert:
      expr: topology == T_linear
      message: "Must preserve T_linear topology"

output:
  format: text
  save: results/08_retrodesign_search.json
  assert:
    - steps <= 10
    - total_delta_xi >= 0.0
