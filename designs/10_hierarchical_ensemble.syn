# Design 10: Multi-Stage Ensemble Design — Same D/T Class
# =========================================================
# Demonstrates: Sequential operations within D/T cluster,
# stepwise complexity growth, F-floor management

version: "1.0"
start: carbonyl_synthon

strategies:
  # Level 1: Form dimer via join with self
  form_dimer:
    - join: carbonyl_synthon  # idempotent join
  
  # Level 2: Path to related linear synthon
  navigate_cluster:
    - path: synthon_methyl_anion_nucleophile_CH3_
      xi_tolerance: 3.0
      max_hops: 8
  
  # Level 3: Form ensemble via tensor
  form_ensemble:
    - tensor: synthon_methyl_cation_electrophile_CH3
      lambda: 0.5

do:
  # Execute hierarchical assembly
  - bind: form_dimer
  - bind: navigate_cluster
  - bind: form_ensemble
  
  # Validate final state
  - assert:
      expr: topology == T_linear
      message: "Must preserve T_linear topology"
  
  - assert:
      expr: fidelity == F_eth
      message: "Fidelity should remain F_eth"

output:
  format: text
  save: results/10_hierarchical_ensemble.json
  assert:
    - total_delta_xi < 20.0
    - steps <= 10
