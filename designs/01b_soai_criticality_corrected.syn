# Design 01b: Soai Criticality Path — Corrected Version
# =======================================================
# This version starts from a high-fidelity temporal synthon
# and demonstrates successful criticality ascent.
# Starting point: nitroso_radical_redox_synthon_pair (F_hbar, D_∞)

version: "1.0"
start: nitroso_radical_redox_synthon_pair

do:
  # Step 1: Lift to criticality (should succeed: F_hbar meets requirement)
  - lift: critical
  
  # Step 2: Assert we achieved criticality phase
  - assert:
      expr: criticality_phase == Phi_c
      message: "Must reach Phi_c after criticality lift"
  
  # Step 3: Assert phi_c_score exceeds threshold (Varma probe validation)
  - assert:
      expr: phi_c_score > 0.3
      message: "Criticality candidate must have phi_c > 0.3"
  
  # Step 4: Meet with proline_aldol_cycle (both are D_∞, T_bowtie)
  # This tests lattice operations in the temporal domain
  - meet: proline_aldol_cycle
  
  # Step 5: Assert the meet preserved criticality (Phi_c dominates)
  - assert:
      expr: criticality_phase == Phi_c
      message: "Meet should preserve criticality (Phi_c dominates)"

output:
  format: text
  save: results/01b_soai_criticality_corrected.json
