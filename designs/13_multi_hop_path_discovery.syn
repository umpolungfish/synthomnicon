# Design 13: Multi-Hop Path Discovery — Long-Range Navigation
# =============================================================
# Demonstrates: Extended path search, hop budget management,
# cluster exploration, connectivity analysis

version: "1.0"
start: carbonyl_synthon

do:
  # Step 1: Long-range path search with generous hop budget
  # Navigate within D_wedge/T_linear cluster
  - path: synthon_methyl_anion_nucleophile_CH3_
    xi_tolerance: 4.0
    max_hops: 10
  
  # Step 2: Tensor with electrophile (anion-cation pairing)
  - tensor: synthon_methyl_cation_electrophile_CH3
    lambda: 0.6  # High MI (complementary charges)
  
  # Step 3: Validate topology
  - assert:
      expr: topology == T_linear
      message: "Final topology must be T_linear"
  
  # Step 4: Join to raise fidelity
  - join: synthon_acylium_ion_electrophile_R_C+=
  
  # Step 5: Validate fidelity raised
  - assert:
      expr: fidelity == F_eth
      message: "F_eth should be preserved"

output:
  format: json
  save: results/13_multi_hop_path_discovery.json
  assert:
    - steps <= 10
    - total_delta_xi < 20.0
